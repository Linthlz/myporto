# Web3Forms access key — delivers contact-form messages to your inbox.
# 1. Go to https://web3forms.com, enter the email that should receive messages
# 2. Copy the access key from the email they send you
# 3. Copy this file to `.env` and paste the key below (also add it as an
#    environment variable on your hosting, e.g. Vercel / Netlify)
VITE_WEB3FORMS_KEY=
